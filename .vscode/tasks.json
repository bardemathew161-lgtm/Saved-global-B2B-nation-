{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Cloudflare Pages locally",
			"type": "process",
			"command": "npx",
			"args": [
				"--yes",
				"wrangler@latest",
				"pages",
				"dev",
				".",
				"--ip",
				"0.0.0.0",
				"--port",
				"8788"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": true,
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		}
	]
}